"NSHealthShareUsageDescription" = "آپ کے آلے پر نجی فٹنس ٹائم لائن اور معلومات دکھانے کے لیے BIL صرف آپ کی منتخب کردہ Health کی کیٹیگریز—سرگرمی، نیند، جسمانی پیمائش، دل کے اشاریے، جسم میں پانی کی مقدار اور غذائیت—پڑھتا ہے۔ صرف جب آپ ذاتی ذہانت (Personalized Intelligence) فعال کرکے BIL Coach سے سوال کرتے ہیں، تو جواب دینے کے لیے کم سے کم متعلقہ ڈیٹا کو کلاؤڈ AI محفوظ طریقے سے پراسیس کر سکتی ہے۔";
"NSHealthUpdateUsageDescription" = "BIL صرف اس وقت وزن کے ریکارڈ لکھتا ہے جب آپ Health میں لکھنے کی الگ اجازت دیتے ہیں۔";
"NSBluetoothAlwaysUsageDescription" = "BIL صرف ان فٹنس ڈیوائسز سے منسلک ہوتا ہے جنہیں آپ واضح طور پر پیئر کرتے ہیں، تاکہ پیمائشیں مقامی طور پر درآمد کی جا سکیں۔";
"NSCameraUsageDescription" = "کیمرہ صرف اس وقت استعمال کریں جب آپ بار کوڈ اسکین کرنے، کھانے کی تصویر کا جائزہ لینے، یا نجی پروفائل یا پروگریس فوٹو شامل کرنے کا انتخاب کریں۔";
"NSPhotoLibraryUsageDescription" = "BIL صرف اس تصویر تک رسائی لیتا ہے جو آپ کھانے، پروفائل، پیش رفت، کمیونٹی پوسٹ یا خوراک جمع کرانے کے لیے منتخب کرتے ہیں، تاکہ محفوظ یا اپ لوڈ کرنے سے پہلے جائزہ لے سکیں۔";
"NSMicrophoneUsageDescription" = "BIL مائیکروفون صرف اس وقت استعمال کرتا ہے جب آپ صوتی اِن پٹ شروع کرتے ہیں۔ آواز اسی ڈیوائس پر متن میں بدلی جاتی ہے اور ڈیوائس پر شناخت دستیاب نہ ہو تو اِن پٹ رک جاتا ہے۔ خام آڈیو Gemini کو نہیں بھیجی جاتی۔ Gemini، AI Coach کو بھیجا گیا متن صرف Personalized Intelligence فعال کرنے اور متن بھیجنے کے بعد پروسیس کرتا ہے۔ صوتی اِن پٹ میں وزن، کھانے اور کمیونٹی پوسٹس شامل ہیں۔";
"NSSpeechRecognitionUsageDescription" = "BIL وزن، کھانے، کمیونٹی پوسٹ یا AI Coach کی آواز اسی ڈیوائس پر متن میں بدلتا ہے اور ڈیوائس پر شناخت دستیاب نہ ہو تو رک جاتا ہے۔ خام آڈیو کبھی Gemini کو نہیں بھیجی جاتی؛ AI Coach کا متن Personalized Intelligence فعال کرکے بھیجنے کے بعد ہی Gemini تک پہنچتا ہے۔";
