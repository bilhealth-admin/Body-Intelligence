"NSHealthShareUsageDescription" = "आपके डिवाइस पर निजी फ़िटनेस टाइमलाइन और अहम जानकारियाँ दिखाने के लिए BIL केवल आपकी चुनी हुई Health श्रेणियाँ—गतिविधि, नींद, शरीर के माप, हृदय मेट्रिक्स, हाइड्रेशन और पोषण—पढ़ता है। केवल जब आप व्यक्तिगत इंटेलिजेंस (Personalized Intelligence) चालू करके BIL Coach से कोई प्रश्न पूछते हैं, तब उत्तर देने के लिए न्यूनतम प्रासंगिक डेटा को क्लाउड AI द्वारा सुरक्षित रूप से संसाधित किया जा सकता है।";
"NSHealthUpdateUsageDescription" = "BIL केवल तब वज़न रिकॉर्ड लिखता है जब आप Health में लिखने की अलग से अनुमति देते हैं।";
"NSBluetoothAlwaysUsageDescription" = "BIL केवल उन फ़िटनेस डिवाइस से कनेक्ट होता है जिन्हें आप स्पष्ट रूप से पेयर करते हैं, ताकि माप को डिवाइस पर ही इंपोर्ट किया जा सके।";
"NSCameraUsageDescription" = "कैमरे का उपयोग केवल तभी करें जब आप बारकोड को स्कैन करना, भोजन की तस्वीर की समीक्षा करना, या एक निजी प्रोफ़ाइल या प्रगति फोटो जोड़ना चुनते हैं।";
"NSPhotoLibraryUsageDescription" = "BIL केवल उस फ़ोटो तक पहुँचता है जिसे आप भोजन, प्रोफ़ाइल, प्रगति, समुदाय पोस्ट या खाद्य योगदान के लिए चुनते हैं, ताकि सहेजने या अपलोड करने से पहले उसकी समीक्षा कर सकें।";
"NSMicrophoneUsageDescription" = "BIL माइक्रोफ़ोन का उपयोग केवल तब करता है जब आप वॉइस इनपुट शुरू करते हैं। यह इस डिवाइस पर ही आवाज़ को टेक्स्ट में बदलता है और डिवाइस पर पहचान उपलब्ध न होने पर रुक जाता है। कच्चा ऑडियो Gemini को नहीं भेजा जाता। Gemini, AI Coach को भेजे गए टेक्स्ट को तभी संसाधित करता है जब आप Personalized Intelligence चालू करके उसे भेजते हैं। वॉइस इनपुट में वज़न, भोजन और समुदाय पोस्ट शामिल हैं।";
"NSSpeechRecognitionUsageDescription" = "BIL वजन, भोजन, समुदाय पोस्ट या AI Coach की आवाज़ को इस डिवाइस पर ही टेक्स्ट में बदलता है और डिवाइस पर पहचान उपलब्ध न होने पर रुक जाता है। कच्चा ऑडियो Gemini को कभी नहीं भेजा जाता; AI Coach का टेक्स्ट Personalized Intelligence चालू करके भेजने के बाद ही Gemini तक पहुँचता है।";
