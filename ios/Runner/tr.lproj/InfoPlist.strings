"NSHealthShareUsageDescription" = "Cihazınızda size özel ve gizli bir fitness zaman çizelgesi ile analizler göstermek için BIL yalnızca seçtiğiniz Health kategorilerini (aktivite, uyku, vücut ölçümleri, kalp metrikleri, hidrasyon ve beslenme) okur. Yalnızca kişiselleştirilmiş zekâyı (Personalized Intelligence) etkinleştirip BIL Coach'a soru sorduğunuzda, yanıt vermek için gereken asgari ilgili veriler bulut yapay zekâsı (AI) tarafından güvenli biçimde işlenebilir.";
"NSHealthUpdateUsageDescription" = "BIL yalnızca Health yazma erişimini ayrıca onayladıktan sonra kilo kayıtlarını yazar.";
"NSBluetoothAlwaysUsageDescription" = "BIL yalnızca açıkça eşleştirdiğiniz fitness cihazlarına bağlanır; böylece ölçümler yerel olarak içe aktarılabilir.";
"NSBluetoothPeripheralUsageDescription" = "BIL yalnızca açıkça eşleştirdiğiniz fitness cihazlarına bağlanır; böylece ölçümler yerel olarak içe aktarılabilir.";
"NSCameraUsageDescription" = "Kamerayı yalnızca barkod taramayı, öğün fotoğrafını incelemeyi veya özel profil ya da ilerleme fotoğrafı eklemeyi seçtiğinizde kullanın.";
"NSPhotoLibraryUsageDescription" = "BIL yalnızca öğün, profil, ilerleme, topluluk gönderisi veya yiyecek katkısı için seçtiğiniz fotoğrafa erişir; böylece kaydetmeden ya da yüklemeden önce inceleyebilirsiniz.";
"NSMicrophoneUsageDescription" = "BIL mikrofonu yalnızca kilo, öğün, topluluk gönderileri veya BIL AI Coach için sesli girişi seçtiğinizde kullanır. Metni kaydetmeden, yayımlamadan veya göndermeden önce inceleyebilirsiniz.";
"NSSpeechRecognitionUsageDescription" = "BIL, kilo, öğün, topluluk gönderileri veya BIL AI Coach için başlattığınız konuşmayı metne dönüştürür. Metni kaydetmeden, yayımlamadan veya göndermeden önce inceleyebilirsiniz.";